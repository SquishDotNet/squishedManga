@page
@model RazorPagesManga.Pages_Manga.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Manga</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Manga.Id" />
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Manga.Title" class="control-label"></label>
                <input asp-for="Manga.Title" class="form-control" aria-required="true"/>
                <span asp-validation-for="Manga.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Manga.Author" class="control-label"></label>
                <input asp-for="Manga.Author" class="form-control" aria-required="true"/>
                <span asp-validation-for="Manga.Author" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Manga.Genre" class="control-label"></label>
                <input asp-for="Manga.Genre" class="form-control" aria-required="true"/>
                <span asp-validation-for="Manga.Genre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Manga.VolumeCount" class="control-label"></label>
                <input asp-for="Manga.VolumeCount" class="form-control" />
                <span asp-validation-for="Manga.VolumeCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Manga.ReleaseDate" class="control-label"></label>
                <input asp-for="Manga.ReleaseDate" class="form-control" />
                <span asp-validation-for="Manga.ReleaseDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
